[Unit]
Description=HF bridge GPS logger for range scoring
After=network.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/reticulum-hf-bridge
Environment=PYTHONPATH=src
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/YOUR_USER/reticulum-hf-bridge/.venv/bin/python -m hfbridge.gpslog \
    --device /dev/ttyACM0 \
    --csv /home/YOUR_USER/hf-logs/field-gps.csv
Restart=always
RestartSec=5
StandardOutput=append:/home/YOUR_USER/hf-logs/field-gps.log
StandardError=append:/home/YOUR_USER/hf-logs/field-gps.log

[Install]
WantedBy=multi-user.target
