# Source this from the repo root before radio bench tests:
#   set -a && source .env && set +a
#
# Built librtlsdr and rtl_* tools live under third_party/prefix
PATH="${PWD}/third_party/prefix/bin:${PATH}"
DYLD_LIBRARY_PATH="${PWD}/third_party/prefix/lib${DYLD_LIBRARY_PATH:+:${DYLD_LIBRARY_PATH}}"
PYTHONPATH="${PWD}/third_party/Hermes-Lite2/software/hermeslite${PYTHONPATH:+:${PYTHONPATH}}"
